---
export const prerender = true;

// Sandbox test of @starwind-pro/shader-topographic-flow — not an adoption.
// ADR-019 forbids direct starwind-pro/ imports in pages; this lab page is the
// deliberate exception. If the shader makes the cut, fork it into a project
// component (e.g. Hero.astro) with a lineage header and drop this import.
//
// Body is a copy of src/pages/index.astro (data loading, markup, styles) laid
// over the shader to judge the real homepage against it. Not kept in sync —
// re-copy if the homepage changes before a decision is made.
//
// Light-mode spike: the shader is a throwaway local fork (./_shader-light/)
// with a base colour and an ink-on-paper blend. Colours come from --topo-*
// custom properties so the runtime re-reads them on theme or variant change.
// The Quiet/Present switch only affects light mode; dark is the original look.
import ThemedTopographicFlow from './_shader-light/ThemedTopographicFlow.astro';

import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import FeaturedPostCard from '@components/FeaturedPostCard.astro';
import RecentPostsList from '@components/RecentPostsList.astro';
import ReadWidget from '@components/widgets/ReadWidget.astro';
import ListenWidget from '@components/widgets/ListenWidget.astro';
import WatchWidget from '@components/widgets/WatchWidget.astro';
import GameWidget from '@components/widgets/GameWidget.astro';
import ThreadsWidget from '@components/widgets/ThreadsWidget.astro';
import IconBrandGithub from '@tabler/icons/outline/brand-github.svg';
import IconActivityHeartbeat from '@tabler/icons/outline/activity-heartbeat.svg';
import '@styles/widgets.css';

const posts = (await getCollection('posts'))
  .filter((post) => (import.meta.env.PROD ? !post.data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// All six activity data sources, loaded once and used to derive both the
// `last fetched` timestamp under the Now heading and the inline Code/Move chips.
const dataModules = await Promise.all([
  import('../../data/reading.json'),
  import('../../data/listening.json'),
  import('../../data/watching.json'),
  import('../../data/gaming.json'),
  import('../../data/github.json'),
  import('../../data/whoop.json'),
]);
const [, , , , githubData, whoopData] = dataModules.map((m) => m.default as Record<string, unknown>);

const lastFetchMs = dataModules
  .map((m) => (m.default as { lastUpdated?: string | null }).lastUpdated)
  .filter((s): s is string => Boolean(s))
  .map((s) => new Date(s).getTime())
  .filter((t) => !Number.isNaN(t))
  .reduce((max, t) => (t > max ? t : max), 0);
const lastFetch = lastFetchMs > 0 ? new Date(lastFetchMs) : null;
const lastFetchDisplay = lastFetch
  ? `${lastFetch.toISOString().slice(0, 10)} · ${lastFetch.toISOString().slice(11, 16)} UTC`
  : null;
const lastFetchIso = lastFetch?.toISOString() ?? '';

// Coding chip: current streak + last-7-day contribution sparkline (level 0-4).
const codeStreak = Number((githubData?.streak as { current?: number })?.current ?? 0);
const codeDays = ((githubData?.calendar as { weeks?: Array<{ days?: Array<{ level?: number }> }> })?.weeks ?? [])
  .flatMap((w) => w.days ?? [])
  .slice(-7)
  .map((d) => Number(d?.level ?? 0));
const codeHasSignal = codeStreak > 0 || codeDays.some((l) => l > 0);

// Move chip: latest workout summary + recent-strain sparkline (newest right).
// Padded to a fixed slot count so its bar widths match the coding chip's 7-day
// spark — missing slots render as faint ghost bars rather than a few fat bars.
const SPARK_SLOTS = 7;
interface Workout { sport?: string; durationMinutes?: number; strain?: number }
const recentWorkouts = ((whoopData?.recentWorkouts as Workout[]) ?? []);
const moveLatest = recentWorkouts[0] ?? null;
const moveStrainRaw = recentWorkouts.slice(0, SPARK_SLOTS).reverse().map((w) => Number(w?.strain) || 0);
const moveStrainMax = Math.max(...moveStrainRaw, 1);
const moveSpark: (number | null)[] = [
  ...Array(Math.max(0, SPARK_SLOTS - moveStrainRaw.length)).fill(null),
  ...moveStrainRaw,
];
const moveHasSignal = !!moveLatest;
---

<BaseLayout
  title="Shader sandbox"
  description="Homepage content over the Starwind Pro Topographic Flow shader"
  accent="neutral"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main id="main-content" class="gvns-shader-main">
    <section
      id="shader-topographic-flow-demo"
      class="gvns-topo gvns-topo--present bg-background text-foreground @container relative isolate w-full overflow-hidden"
      data-shader-demo="topographic-flow"
    >
      <ThemedTopographicFlow
        baseColor="var(--topo-base)"
        contourLineColor="var(--topo-line)"
        majorLineColor="var(--topo-major)"
        mapWashColor="var(--topo-wash)"
        contourScale={3.4}
        contourSpacing={1}
        contourWidth={1}
        contourDrift={0.28}
        lineStrength={0.75}
        opacity={0.94}
      />

      <div class="gvns-home relative z-10">
        <div class="gvns-topo-toolbar">
          <button type="button" class="gvns-topo-pause" data-topo-pause>Pause motion</button>
          <div class="gvns-topo-switch" role="group" aria-label="Light-mode shader variant">
            <span class="gvns-topo-switch__label">light shader</span>
            <button type="button" data-topo-variant="quiet" aria-pressed="false">Quiet</button>
            <button type="button" data-topo-variant="present" aria-pressed="true">Present</button>
          </div>
        </div>
        {posts.length > 1 ? (
          <section class="gvns-home__split" aria-label="Recent posts">
            <div class="gvns-home__featured">
              <FeaturedPostCard post={posts[0]} />
            </div>
            <div class="gvns-home__sidebar">
              <div class="gvns-topo-scrim">
                <RecentPostsList posts={posts.slice(1, 5)} />
              </div>
              <ThreadsWidget />
            </div>
          </section>
        ) : posts.length === 1 ? (
          <section class="gvns-home__posts" aria-label="Recent posts">
            <FeaturedPostCard post={posts[0]} />
          </section>
        ) : (
          <section class="gvns-home__posts gvns-home__posts--empty gvns-topo-scrim" aria-label="Recent posts">
            <p class="gvns-empty-state">
              Currently drafting in private. See what I'm up to on <a href="/now">/now</a>.
            </p>
          </section>
        )}
        <section class="gvns-activity-widgets" aria-label="Current activity">
          <header class="gvns-now gvns-topo-scrim">
            <div class="gvns-now__row">
              <h2 class="gvns-now__title">
                <a class="gvns-now__link" href="/now">Now</a>
              </h2>
              <span class="gvns-now__cursor" aria-hidden="true"></span>
              <span class="gvns-now__arrow" aria-hidden="true">&rarr;</span>
            </div>
            <div class="gvns-now__meta">
              {lastFetch && (
                <p class="gvns-now__date">
                  <span class="gvns-now__branch" aria-hidden="true">&#x2514;</span>
                  <time datetime={lastFetchIso}>{lastFetchDisplay}</time>
                </p>
              )}
              <div class="gvns-now__stats">
                {codeHasSignal && (
                  <a href="/code" class="gvns-now__chip gvns-now__chip--code">
                    <IconBrandGithub class="gvns-now__chip-icon" aria-hidden="true" />
                    <span class="gvns-now__chip-spark" aria-hidden="true">
                      {codeDays.map((level) => (
                        <i style={`height: ${Math.max((level / 4) * 100, 12)}%; opacity: ${0.3 + (level / 4) * 0.7}`}></i>
                      ))}
                    </span>
                    <span class="gvns-now__chip-text">
                      <span class="gvns-now__chip-label">coding</span>
                      <span class="gvns-now__chip-value">{codeStreak}-day streak</span>
                    </span>
                  </a>
                )}
                {moveHasSignal && (
                  <a href="/move" class="gvns-now__chip gvns-now__chip--move">
                    <IconActivityHeartbeat class="gvns-now__chip-icon" aria-hidden="true" />
                    <span class="gvns-now__chip-spark" aria-hidden="true">
                      {moveSpark.map((s) => (
                        s === null
                          ? <i class="gvns-now__chip-bar--ghost"></i>
                          : <i style={`height: ${Math.max((s / moveStrainMax) * 100, 12)}%; opacity: ${0.4 + (s / moveStrainMax) * 0.6}`}></i>
                      ))}
                    </span>
                    <span class="gvns-now__chip-text">
                      <span class="gvns-now__chip-label">move</span>
                      <span class="gvns-now__chip-value">{moveLatest!.sport} &middot; {moveLatest!.durationMinutes}m</span>
                    </span>
                  </a>
                )}
              </div>
            </div>
          </header>
          <div class="gvns-activity-grid">
            <ReadWidget compact />
            <ListenWidget compact />
            <WatchWidget compact />
            <GameWidget compact />
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // ?light=quiet|present picks the starting variant so a link can be shared.
  const section = document.getElementById('shader-topographic-flow-demo');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-topo-variant]');

  function setVariant(variant: string) {
    if (!section) return;
    // Swapping the class is what the shader runtime's observer reacts to.
    section.classList.toggle('gvns-topo--quiet', variant === 'quiet');
    section.classList.toggle('gvns-topo--present', variant !== 'quiet');
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topoVariant === variant)));
    const url = new URL(location.href);
    url.searchParams.set('light', variant);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => setVariant(b.dataset.topoVariant ?? 'present')));
  const initial = new URLSearchParams(location.search).get('light');
  if (initial === 'quiet' || initial === 'present') setVariant(initial);

  // Pause/play (WCAG 2.2.2). Freezes the shader's clock via the fork's
  // frozen/frozenTime/timeOffset inputs so resuming continues without a jump.
  // Remembered per browser; storage can throw (private mode), so guard it.
  const PAUSE_KEY = 'gvns-shader-paused';
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-topo-pause]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-shader-topographic-flow-canvas]');
  let pausedAt = 0;
  let offset = 0;

  const elapsed = () => (performance.now() - Number(canvas?.dataset.shaderStartedAt ?? 0)) / 1000;

  function setPaused(paused: boolean, remember = true) {
    if (!canvas || !pauseBtn) return;
    if (paused) {
      pausedAt = elapsed();
      canvas.setAttribute('data-shader-frozen-time', String(Math.max(0, pausedAt - offset)));
      canvas.setAttribute('data-shader-frozen', '1');
    } else {
      if (canvas.getAttribute('data-shader-frozen') === '1') offset += elapsed() - pausedAt;
      canvas.setAttribute('data-shader-time-offset', String(offset));
      canvas.setAttribute('data-shader-frozen', '0');
    }
    pauseBtn.textContent = paused ? 'Play motion' : 'Pause motion';
    if (remember) {
      try { localStorage.setItem(PAUSE_KEY, paused ? '1' : '0'); } catch { /* storage blocked */ }
    }
  }

  pauseBtn?.addEventListener('click', () => setPaused(canvas?.getAttribute('data-shader-frozen') !== '1'));
  let storedPaused = false;
  try { storedPaused = localStorage.getItem(PAUSE_KEY) === '1'; } catch { /* storage blocked */ }
  if (storedPaused) setPaused(true, false);
  // Reduced motion already gets the static fallback; the control would do nothing.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches && pauseBtn) pauseBtn.hidden = true;
</script>

<style>
  /* Full-bleed: drop the global main gutters so the shader reaches the edges,
     then re-apply them on the content layer below. */
  .gvns-shader-main {
    padding: 0;
  }

  #shader-topographic-flow-demo {
    min-height: 720px;
    padding: var(--space-8) var(--space-6);
  }

  /* Shader palettes. Dark keeps the original Starwind hues and base (the
     shader's old hard-coded vec3), pulled ~20% toward the base to sit a touch
     quieter than upstream. Light uses the page's zinc-50 paper:
     Present = ink pulled ~20% toward the paper, Quiet = ~60% so the field
     reads as texture behind the cards. */
  .gvns-topo {
    --topo-base: #050708;
    --topo-wash: color-mix(in oklab, #1a857a 85%, #050708);
    --topo-line: color-mix(in oklab, #2e8ffa 80%, #050708);
    --topo-major: color-mix(in oklab, #dbb870 80%, #050708);
  }
  :global(:root:not(.dark)) .gvns-topo--present {
    --topo-base: var(--colour-bg-primary);
    --topo-wash: color-mix(in oklab, #99f6e4 80%, var(--colour-bg-primary)); /* teal-200 */
    --topo-line: color-mix(in oklab, #0369a1 80%, var(--colour-bg-primary)); /* sky-700 */
    --topo-major: color-mix(in oklab, #b45309 80%, var(--colour-bg-primary)); /* amber-700 */
  }
  :global(:root:not(.dark)) .gvns-topo--quiet {
    --topo-base: var(--colour-bg-primary);
    --topo-wash: color-mix(in oklab, #99f6e4 35%, var(--colour-bg-primary));
    --topo-line: color-mix(in oklab, #0369a1 40%, var(--colour-bg-primary));
    --topo-major: color-mix(in oklab, #b45309 55%, var(--colour-bg-primary));
  }

  /* Sandbox controls sit in flow above the posts so they never cover content
     (the fixed version overlapped the Now chips). */
  .gvns-topo-toolbar {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: calc(-1 * var(--space-6));
  }
  .gvns-topo-pause,
  .gvns-topo-switch {
    border: 1px solid var(--colour-border, var(--colour-bg-tertiary));
    border-radius: 999px;
    background: var(--colour-bg-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .gvns-topo-pause {
    padding: var(--space-1) var(--space-3);
    min-height: 2rem;
    color: var(--colour-text-primary);
    cursor: pointer;
  }
  .gvns-topo-pause:focus-visible {
    outline: 2px solid var(--colour-accent-primary);
    outline-offset: 2px;
  }
  .gvns-topo-switch {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
  }
  .gvns-topo-switch__label {
    padding-inline: var(--space-2);
    /* secondary, not muted: muted is 3.7:1 on bg-secondary in dark. */
    color: var(--colour-text-secondary);
  }
  .gvns-topo-switch button {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    color: var(--colour-text-secondary);
    background: transparent;
    cursor: pointer;
  }
  .gvns-topo-switch button[aria-pressed="true"] {
    background: var(--colour-bg-tertiary);
    color: var(--colour-text-primary);
  }
  .gvns-topo-switch button:focus-visible {
    outline: 2px solid var(--colour-accent-primary);
    outline-offset: 2px;
  }

  /* Backing for text that would otherwise sit straight on the moving field
     (WCAG 1.4.3). Measured worst-pixel contrast over the bare shader fell to
     ~2.1:1 for muted meta text; the panel brings it back to near the flat
     background. The blur averages out line edges that show through. */
  .gvns-topo-scrim {
    background: color-mix(in oklab, var(--colour-bg-primary) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
  }

  /* ---- Copied from src/pages/index.astro ---- */
  .gvns-home {
    /* width:100% is load-bearing — without it, BaseLayout's `body{display:flex;flex-direction:column}`
       combined with `margin:0 auto` cross-axis-auto-margins suppresses flex stretch and main collapses
       to intrinsic content width. With width:100% the element claims body width, max-width then caps it,
       and margin:auto centers normally. */
    width: 100%;
    max-width: var(--width-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .gvns-home__split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  @media (max-width: 1023px) {
    .gvns-home__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .gvns-home__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .gvns-home__threads-solo {
    max-width: 24rem;
  }

  .gvns-home__posts--empty {
    padding-block: var(--space-8);
  }

  .gvns-empty-state {
    color: var(--colour-text-secondary);
    font-style: italic;
    margin: 0;
  }

  .gvns-activity-widgets {
    padding-block: var(--space-2);
  }
  /* Bento: four equal tiles (Read P1 → Listen P2 → Watch P3 → Play P4).
     Threads (P5 sky) now lives in the upper-right sidebar beside the featured
     post, not in this row. Move (P6 crimson) lives in the heading-meta chip
     row. Activity-to-token mapping is canonical left-to-right and shared with
     the masthead/footer gradients. */
  .gvns-activity-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (max-width: 1023px) {
    .gvns-activity-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  /* "Now" heading layout:
       title row   — "Now" + blinking cursor (left-aligned)
       meta row    — branch-glyph date (left) + status chips (right, margin-left:auto)
     Chips wrap below the date row at narrow widths via flex-wrap. */
  .gvns-now {
    margin-block-end: var(--space-4);
  }
  .gvns-now__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .gvns-now__meta {
    margin-top: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    row-gap: var(--space-2);
  }
  .gvns-now__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--colour-text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .gvns-now__cursor {
    display: inline-block;
    background: var(--colour-p5-sky);
    width: 5px;
    height: 15px;
    transform: translateY(1px);
    animation: gvns-now-cursor-blink 1.1s steps(1) infinite;
  }
  @keyframes gvns-now-cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* The heading word itself links to /now. P5 Sky is the design system's
     status/now accent — hover/focus pick up sky-hover (sky-400) and the
     decorative trailing arrow nudges 2px right via :has(). */
  .gvns-now__link {
    color: inherit;
    text-decoration: none;
    border-radius: 2px;
    transition: color var(--transition-fast);
  }
  .gvns-now__link:hover,
  .gvns-now__link:focus-visible {
    color: var(--colour-p5-sky-hover);
  }
  .gvns-now__link:focus-visible {
    outline: 2px solid var(--colour-p5-sky-hover);
    outline-offset: 3px;
  }
  .gvns-now__arrow {
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1;
    color: var(--colour-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .gvns-now__row:has(.gvns-now__link:hover) .gvns-now__arrow,
  .gvns-now__row:has(.gvns-now__link:focus-visible) .gvns-now__arrow {
    color: var(--colour-p5-sky-hover);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .gvns-now__cursor { animation: none; }
    .gvns-now__arrow { transition: color var(--transition-fast); }
    .gvns-now__row:has(.gvns-now__link:hover) .gvns-now__arrow,
    .gvns-now__row:has(.gvns-now__link:focus-visible) .gvns-now__arrow {
      transform: none;
    }
  }

  /* Inline status chips — Coding (P1 violet) + Move (P6 crimson). Each is a
     link to the relevant /code or /move detail page; the sparkline is decorative. */
  .gvns-now__stats {
    display: flex;
    gap: var(--space-6);
    margin-left: auto;
    align-items: center;
    flex-wrap: wrap;
    row-gap: var(--space-2);
  }
  .gvns-now__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-fast);
  }
  .gvns-now__chip:hover .gvns-now__chip-value,
  .gvns-now__chip:focus-visible .gvns-now__chip-value {
    color: var(--chip-accent);
  }
  /* GitHub source attribution mark on the coding chip — kept small so the
     sparkline stays the chip's primary visual. Picks up --chip-accent so the
     icon, sparkline, and value share the P1 Violet column on hover/focus. */
  .gvns-now__chip-icon {
    width: 14px;
    height: 14px;
    color: var(--chip-accent);
    flex-shrink: 0;
  }
  .gvns-now__chip-spark {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
    width: 72px;
  }
  .gvns-now__chip-spark > i {
    display: block;
    flex: 1;
    background: var(--chip-accent);
    border-radius: 1px;
    min-height: 3px;
  }
  /* Ghost bars pad the move spark to a fixed slot count so its bar widths match
     the coding chip; faint and short to read as "no data for this slot". */
  .gvns-now__chip-spark > i.gvns-now__chip-bar--ghost {
    height: 12%;
    opacity: 0.18;
  }
  .gvns-now__chip-text {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
  }
  .gvns-now__chip-label {
    color: var(--colour-text-muted);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }
  .gvns-now__chip-value {
    color: var(--colour-text-secondary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-fast);
  }
  .gvns-now__chip--code { --chip-accent: var(--colour-p1-violet); }
  .gvns-now__chip--move { --chip-accent: var(--colour-p6-crimson); }

  .gvns-now__date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .gvns-now__branch {
    color: var(--colour-p5-sky);
    opacity: 0.55;
  }
  .gvns-now__date time {
    color: inherit;
    font-variant-numeric: tabular-nums;
